{
    "id":  "balanced",
    "name":  "Balanced Gaming",
    "description":  "Safe plus gaming-oriented configuration that keeps Windows functionality: windowed-game optimizations, VRR, browser background modes off, widgets off, USB/network power management for input and connection stability, and fewer telemetry tasks.",
    "maxRisk":  "Low",
    "requiresExplicitOptIn":  false,
    "includeRefreshRateFix":  true,
    "tweaks":  [
                   "gaming.gamemode.enable",
                   "gaming.backgroundrecording.disable",
                   "gaming.gamebar.startuptips.disable",
                   "input.stickykeys.hotkey.disable",
                   "input.togglekeys.hotkey.disable",
                   "input.filterkeys.hotkey.disable",
                   "privacy.advertisingid.disable",
                   "privacy.tailored.disable",
                   "privacy.languagelist.optout",
                   "privacy.feedback.never",
                   "cdm.silentapps.disable",
                   "cdm.startsuggestions.disable",
                   "cdm.tips.disable",
                   "cdm.welcome.disable",
                   "cdm.settings.suggestions",
                   "cdm.lockscreen.tips",
                   "privacy.finishsetup.disable",
                   "search.highlights.disable",
                   "gaming.gamedvr.disable",
                   "gaming.windowed.optimizations",
                   "gaming.vrr.enable",
                   "mem.edge.startupboost.disable",
                   "mem.edge.backgroundmode.disable",
                   "mem.chrome.backgroundmode.disable",
                   "explorer.widgets.disable",
                   "explorer.newsinterests.win10.disable",
                   "search.websuggestions.disable",
                   "net.deliveryoptimization.nopeer",
                   "net.adapter.powersaving.disable",
                   "cpu.powerplan.highperformance",
                   "power.usb.selectivesuspend.disable",
                   "startup.delay.remove",
                   "privacy.activityhistory.disable",
                   "ui.menushowdelay",
                   "task.appraiser.disable",
                   "task.appraiser.exp.disable",
                   "task.ceip.consolidator.disable",
                   "task.ceip.usbceip.disable",
                   "task.feedback.dmclient.disable",
                   "task.feedback.dmclientscenario.disable"
               ]
}
