<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <Color x:Key="Bg0Color">#07090D</Color>
    <Color x:Key="Bg1Color">#0B0F15</Color>
    <Color x:Key="SurfaceColor">#111720</Color>
    <Color x:Key="Surface2Color">#17202B</Color>
    <Color x:Key="Surface3Color">#1E2936</Color>
    <Color x:Key="BorderColor">#212C3A</Color>
    <Color x:Key="BorderBrightColor">#2E3D52</Color>

    <!-- Accents -->
    <Color x:Key="AccentColor">#00B4FF</Color>
    <Color x:Key="CyanColor">#00E5FF</Color>
    <Color x:Key="PurpleColor">#8B5CF6</Color>

    <!-- Text -->
    <Color x:Key="TextColor">#E6EDF5</Color>
    <Color x:Key="TextDimColor">#9AA8BB</Color>
    <Color x:Key="TextMutedColor">#5F6E82</Color>

    <!-- Status -->
    <Color x:Key="SuccessColor">#22C55E</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="InfoColor">#38BDF8</Color>

    <SolidColorBrush x:Key="Bg0Brush" Color="{StaticResource Bg0Color}" />
    <SolidColorBrush x:Key="Bg1Brush" Color="{StaticResource Bg1Color}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3Brush" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderBrightBrush" Color="{StaticResource BorderBrightColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanColor}" />
    <SolidColorBrush x:Key="PurpleBrush" Color="{StaticResource PurpleColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />

    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2200B4FF" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#2222C55E" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#26F59E0B" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#26EF4444" />
    <SolidColorBrush x:Key="PurpleSoftBrush" Color="#268B5CF6" />
    <SolidColorBrush x:Key="NeutralSoftBrush" Color="#1F9AA8BB" />
    <SolidColorBrush x:Key="GlassBrush" Color="#D9111720" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#B3000000" />

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00B4FF" Offset="0" />
        <GradientStop Color="#00E5FF" Offset="0.55" />
        <GradientStop Color="#8B5CF6" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryButtonBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0096E0" Offset="0" />
        <GradientStop Color="#00C2F0" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1A00B4FF" Offset="0" />
        <GradientStop Color="#0D111720" Offset="0.6" />
        <GradientStop Color="#1F8B5CF6" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="WindowBackdropBrush" Center="0.85,0" GradientOrigin="0.85,0" RadiusX="0.9" RadiusY="0.8">
        <GradientStop Color="#0F1B2B" Offset="0" />
        <GradientStop Color="#07090D" Offset="1" />
    </RadialGradientBrush>

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
</ResourceDictionary>
