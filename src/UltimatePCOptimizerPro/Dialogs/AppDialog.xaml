<Window x:Class="UltimatePCOptimizerPro.Dialogs.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" SizeToContent="Height" Width="780" ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrightBrush}" BorderThickness="1" CornerRadius="14" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" Color="Black" />
        </Border.Effect>
        <Grid Margin="24,22,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" MouseLeftButtonDown="OnDrag" Background="Transparent">
                <Border Width="34" Height="34" CornerRadius="9" Background="{Binding IconBackground}" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="{Binding IconForeground}" />
                </Border>
                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" FontSize="19" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="640" />
            </StackPanel>

            <TextBlock Grid.Row="1" Text="{Binding Message}" Style="{StaticResource Body}" Margin="0,14,0,0" FontSize="13.5" LineHeight="20" />

            <Border Grid.Row="2" Margin="0,14,0,0" Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}"
                    Background="{StaticResource Bg1Brush}" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <ScrollViewer MaxHeight="{Binding ListMaxHeight}" VerticalScrollBarVisibility="Auto" Padding="4">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Opacity="{Binding Opacity}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Value}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Mono}" FontSize="11" Margin="0,2,0,0"
                                                       Visibility="{Binding Subtitle, Converter={StaticResource NullToVis}}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,3,0,0"
                                                       Visibility="{Binding Detail, Converter={StaticResource NullToVis}}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource Badge}" Background="{Binding BadgeBackground}" Margin="10,0,0,0" VerticalAlignment="Top"
                                                Visibility="{Binding Badge, Converter={StaticResource NullToVis}}">
                                            <TextBlock Text="{Binding Badge}" Style="{StaticResource BadgeText}" Foreground="{Binding BadgeForeground}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <CheckBox Grid.Row="3" Margin="0,14,0,0" IsChecked="{Binding Acknowledged}" Visibility="{Binding Acknowledgement, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding Acknowledgement}" TextWrapping="Wrap" MaxWidth="660" Foreground="{StaticResource WarningBrush}" />
            </CheckBox>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="{Binding TertiaryText}" Click="OnTertiary" Visibility="{Binding TertiaryText, Converter={StaticResource NullToVis}}" />
                <Button Content="{Binding SecondaryText}" Click="OnSecondary" Visibility="{Binding SecondaryText, Converter={StaticResource NullToVis}}" IsCancel="True" />
                <Button Content="{Binding PrimaryText}" Click="OnPrimary" Style="{Binding PrimaryStyle}" IsEnabled="{Binding PrimaryEnabled}" Margin="0" IsDefault="True"
                        Visibility="{Binding PrimaryText, Converter={StaticResource NullToVis}}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
