<Window x:Class="UltimatePCOptimizerPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ULTIMATE PC OPTIMIZER PRO" Width="1440" Height="900" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackdropBrush}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" Icon="Resources/Icons/app.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================== Sidebar -->
        <Border Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,22,20,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentGradientBrush}">
                            <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="#03131E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ULTIMATE PC" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="OPTIMIZER PRO" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentGradientBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Margin="14" Padding="12" CornerRadius="10" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" Fill="{Binding IsElevated, Converter={StaticResource StatusBrush}}" />
                            <TextBlock Text="{Binding ElevationText}" FontSize="12" Foreground="{StaticResource TextDimBrush}" />
                        </StackPanel>
                        <TextBlock Text="Changes require administrator rights (restore points)." Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Visibility="{Binding IsElevated, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        <Button Content="Restart as administrator" Command="{Binding RestartAsAdminCommand}" Style="{StaticResource SmallButton}" Margin="0,8,0,0"
                                HorizontalAlignment="Stretch" Visibility="{Binding IsElevated, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}" Style="{StaticResource NavListBox}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="False">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource H3}" Margin="22,14,0,4" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="15" Width="22" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                <TextBlock Text="{Binding Title}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============================== Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="32,24,32,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding CurrentPage.Title}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding CurrentPage.Subtitle}" Style="{StaticResource Body}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Border Style="{StaticResource Badge}" Background="{StaticResource AccentSoftBrush}" Padding="10,5" Margin="0,0,8,0"
                            Visibility="{Binding State.IsScanning, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource BadgeText}" Foreground="{StaticResource AccentBrush}">
                            <Run Text="Scanning:" /> <Run Text="{Binding State.ScanStep, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource Badge}" Background="{StaticResource PurpleSoftBrush}" Padding="10,5"
                            Visibility="{Binding State.Tier, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding State.Tier.TierDisplay}" Style="{StaticResource BadgeText}" Foreground="{StaticResource PurpleBrush}" />
                    </Border>
                </StackPanel>
            </Grid>
            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" Margin="32,0,20,0" Focusable="False" />
        </Grid>

        <!-- ============================== Busy overlay -->
        <Grid Grid.ColumnSpan="2" Background="{StaticResource OverlayBrush}" Visibility="{Binding Busy.IsBusy, Converter={StaticResource BoolToVis}}">
            <Border Width="460" Padding="26" CornerRadius="14" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrightBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Working…" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding Busy.Message}" Style="{StaticResource Body}" Margin="0,0,0,16" />
                    <ProgressBar IsIndeterminate="True" />
                    <TextBlock Text="Please don't close the application while system settings are being changed." Style="{StaticResource Caption}" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
