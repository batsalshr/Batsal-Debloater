<UserControl x:Class="UltimatePCOptimizerPro.Views.FpsBoosterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:UltimatePCOptimizerPro.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,20">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Current gaming configuration" Style="{StaticResource H2}" />
                        <ItemsControl ItemsSource="{Binding Info}" ItemTemplate="{StaticResource InfoRowTemplate}" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Windows Graphics settings" Command="{Binding OpenGraphicsSettingsCommand}" Style="{StaticResource SmallButton}" />
                            <Button Content="Game Mode settings" Command="{Binding OpenGamingSettingsCommand}" Style="{StaticResource SmallButton}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Refresh rate check" Style="{StaticResource H2}" />
                        <ItemsControl ItemsSource="{Binding Displays}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InnerCard}" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Value}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Current}" Style="{StaticResource Body}" FontSize="12.5" />
                                                <TextBlock Style="{StaticResource Caption}"><Run Text="Supported: " /><Run Text="{Binding Supported, Mode=OneWay}" /><Run Text=" Hz" /></TextBlock>
                                                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Foreground="{Binding CanRaise, Converter={StaticResource StatusBrush}}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Set to maximum" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.RaiseRefreshCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                    Visibility="{Binding CanRaise, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="VRR (G-SYNC/FreeSync) is configured in the GPU control panel and the monitor's menu; Windows does not expose whether it is active." Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="FPS, frame time and latency — what actually helps" Style="{StaticResource H2}" />
                    <ItemsControl ItemsSource="{Binding Guidance}" ItemTemplate="{StaticResource BulletTemplate}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Gaming, graphics and power settings" Style="{StaticResource H2}" />
                    <v:TweakListView DataContext="{Binding Tweaks}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
