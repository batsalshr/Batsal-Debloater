<UserControl x:Class="UltimatePCOptimizerPro.Views.TweakListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Filters -->
        <Grid Margin="0,0,0,10" Visibility="{Binding ShowFilters, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                <TextBlock Text="Search tweaks by name, description or registry path…" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding Search, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
            </Grid>
            <ComboBox Grid.Column="1" Margin="8,0,0,0" ItemsSource="{Binding Categories}" SelectedItem="{Binding CategoryFilter}" ToolTip="Category" />
            <ComboBox Grid.Column="2" Margin="8,0,0,0" ItemsSource="{Binding TierOptions}" SelectedItem="{Binding TierFilter}" ToolTip="Hardware tier" />
            <ComboBox Grid.Column="3" Margin="8,0,0,0" ItemsSource="{Binding Risks}" SelectedItem="{Binding RiskFilter}" ToolTip="Risk" />
            <ComboBox Grid.Column="4" Margin="8,0,0,0" ItemsSource="{Binding States}" SelectedItem="{Binding StateFilter}" ToolTip="Status" MinWidth="150" />
        </Grid>

        <!-- Actions -->
        <WrapPanel Margin="0,0,0,12">
            <Button Content="Select recommended" Command="{Binding SelectRecommendedCommand}" Style="{StaticResource SmallButton}" ToolTip="Select tweaks recommended for your detected hardware tier that are not applied yet" />
            <Button Content="Select visible" Command="{Binding SelectVisibleCommand}" Style="{StaticResource SmallButton}" />
            <Button Content="Clear" Command="{Binding ClearSelectionCommand}" Style="{StaticResource SmallButton}" />
            <Button Command="{Binding ApplySelectedCommand}" Style="{StaticResource PrimaryButton}" Padding="12,3" MinHeight="26" FontSize="12">
                <TextBlock><Run Text="Apply selected (" /><Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=")" /></TextBlock>
            </Button>
            <Button Content="Restore selected" Command="{Binding RestoreSelectedCommand}" Style="{StaticResource SmallButton}" />
            <Button Content="Save as profile" Command="{Binding SaveProfileCommand}" Style="{StaticResource SmallButton}" />
            <ComboBox ItemsSource="{Binding CustomProfiles}" MinWidth="170" Margin="0,0,8,0" ToolTip="Load a saved custom profile (selects its tweaks)"
                      x:Name="ProfilePicker" SelectionChanged="OnProfilePicked" />
            <Button Content="&#xE72C;" FontFamily="{StaticResource IconFont}" Command="{Binding RefreshCommand}" Style="{StaticResource SmallButton}" ToolTip="Re-read current values" />
            <TextBlock Text="Reading current values…" Style="{StaticResource Caption}" VerticalAlignment="Center" Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVis}}" />
        </WrapPanel>
        <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,0,0,10" />

        <!-- Cards -->
        <ItemsControl ItemsSource="{Binding View}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource InnerCard}" Margin="0,0,0,8" Padding="14,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,2,12,0" IsEnabled="{Binding CanApply}" />
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Value}" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource WarningBrush}" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                                                   Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}" />
                                        <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Background="{StaticResource AccentSoftBrush}" Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="Recommended for your PC" Style="{StaticResource BadgeText}" Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Body}" FontSize="12.5" Margin="0,3,0,6" />
                                    <WrapPanel>
                                        <Border Style="{StaticResource Badge}" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding CategoryText}" Style="{StaticResource BadgeText}" Foreground="{StaticResource TextDimBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Margin="0,0,6,0" Background="{Binding Risk, Converter={StaticResource StatusBrush}, ConverterParameter=soft}">
                                            <TextBlock Style="{StaticResource BadgeText}" Foreground="{Binding Risk, Converter={StaticResource StatusBrush}}"><Run Text="Risk: " /><Run Text="{Binding Risk, Mode=OneWay}" /></TextBlock>
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding RestartText}" Style="{StaticResource BadgeText}" Foreground="{StaticResource TextDimBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding ImpactText}" Style="{StaticResource BadgeText}" Foreground="{StaticResource TextDimBrush}" />
                                        </Border>
                                        <Button Content="Details" Command="{Binding ExpandCommand}" Style="{StaticResource GhostButton}" FontSize="12" MinHeight="20" Padding="4,0" />
                                    </WrapPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="12,0,0,0" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Border Style="{StaticResource Badge}" Background="{Binding StateValue, Converter={StaticResource StatusBrush}, ConverterParameter=soft}" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding StateText}" Style="{StaticResource BadgeText}" Foreground="{Binding StateValue, Converter={StaticResource StatusBrush}}" />
                                        </Border>
                                        <Button Style="{StaticResource SwitchButton}" Tag="{Binding IsApplied}" Command="{Binding ToggleCommand}"
                                                ToolTip="On = applied. Turning off restores the value recorded before this app changed it." />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Information card -->
                            <Border Margin="30,12,0,0" Padding="14" CornerRadius="8" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="What it changes" Style="{StaticResource H3}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Definition.Mechanism}" Style="{StaticResource Body}" FontSize="12.5" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="1" Text="Location" Style="{StaticResource H3}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LocationsText}" Style="{StaticResource Mono}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="2" Text="Current value" Style="{StaticResource H3}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentText}" Style="{StaticResource Mono}" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="3" Text="Proposed value" Style="{StaticResource H3}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TargetText}" Style="{StaticResource Mono}" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="4" Text="Potential benefit" Style="{StaticResource H3}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Definition.Benefit}" Style="{StaticResource Body}" FontSize="12.5" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="5" Text="Potential drawback" Style="{StaticResource H3}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Definition.Drawback}" Style="{StaticResource Body}" FontSize="12.5" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="6" Text="Recommended for" Style="{StaticResource H3}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Definition.RecommendedFor}" Style="{StaticResource Body}" FontSize="12.5" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="7" Text="Risk level" Style="{StaticResource H3}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Risk}" Style="{StaticResource Body}" FontSize="12.5" Foreground="{Binding Risk, Converter={StaticResource StatusBrush}}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="8" Text="Requires" Style="{StaticResource H3}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource Body}" FontSize="12.5" Margin="0,0,0,8">
                                        <Run Text="{Binding RestartText, Mode=OneWay}" /><Run Text=" · permissions: " /><Run Text="{Binding AdminText, Mode=OneWay}" /><Run Text=" · type: " /><Run Text="{Binding TypeText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="9" Text="Compatibility" Style="{StaticResource H3}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource Body}" FontSize="12.5" Margin="0,0,0,8">
                                        <Run Text="{Binding CompatibilityText, Mode=OneWay}" /><Run Text=" · tiers: " /><Run Text="{Binding TiersText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="10" Text="Status" Style="{StaticResource H3}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource Body}" FontSize="12.5" Margin="0,0,0,8">
                                        <Run Text="{Binding StateText, Mode=OneWay}" Foreground="{Binding StateValue, Converter={StaticResource StatusBrush}}" /><Run Text="  " /><Run Text="{Binding Status.Message, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="11" Text="Evidence / notes" Style="{StaticResource H3}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding Definition.Evidence}" Style="{StaticResource Body}" FontSize="12" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="12" Text="ID" Style="{StaticResource H3}" Margin="0,0,0,8" />
                                    <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding Definition.Id}" Style="{StaticResource Mono}" Margin="0,0,0,8" />
                                    <WrapPanel Grid.Row="13" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                        <Button Content="Apply" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanApply}" />
                                        <Button Content="Restore previous value" Command="{Binding RestoreCommand}" IsEnabled="{Binding CanRestore}" />
                                        <Button Content="Toggle favourite" Command="{Binding FavoriteCommand}" Style="{StaticResource GhostButton}" />
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
