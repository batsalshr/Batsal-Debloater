<UserControl x:Class="UltimatePCOptimizerPro.Views.WindowsTweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:UltimatePCOptimizerPro.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,20">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Explorer, visual effects, privacy and startup" Style="{StaticResource H2}" />
                    <TextBlock Text="Some settings only take effect after Explorer restarts or you sign out — each card says which. Windows' full 'Adjust for best performance' visual-effects switch is available in Performance Options." Style="{StaticResource Body}" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="Restart Explorer" Command="{Binding RestartExplorerCommand}" Style="{StaticResource SmallButton}" />
                        <Button Content="Performance Options (visual effects)" Command="{Binding OpenPerformanceOptionsCommand}" Style="{StaticResource SmallButton}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <v:TweakListView DataContext="{Binding Tweaks}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
