<UserControl x:Class="UltimatePCOptimizerPro.Views.DebloaterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl Margin="0,0,12,0">
        <!-- ============================ Apps -->
        <TabItem Header="Installed apps">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Debloat presets" Style="{StaticResource H2}" />
                        <WrapPanel>
                            <Button Content="Light" Command="{Binding PresetCommand}" CommandParameter="Light" />
                            <Button Content="Gaming" Command="{Binding PresetCommand}" CommandParameter="Gaming" />
                            <Button Content="Advanced" Command="{Binding PresetCommand}" CommandParameter="Advanced" />
                            <Button Content="Custom (clear)" Command="{Binding PresetCommand}" CommandParameter="Custom" />
                            <Button Content="Remove selected apps" Command="{Binding RemoveSelectedCommand}" Style="{StaticResource DangerButton}" />
                            <Button Content="&#xE72C;" FontFamily="{StaticResource IconFont}" Command="{Binding LoadAppsCommand}" ToolTip="Rescan installed packages" />
                        </WrapPanel>
                        <TextBlock Text="{Binding PresetDescription}" Style="{StaticResource Body}" Margin="0,10,0,0" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="Apps are removed for the current user only (other accounts and the Windows image are untouched). Rollback re-registers the app when Windows still has its files; otherwise reinstall it from the Microsoft Store — therefore a verified restore point is always required for app removal." />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox Text="{Binding AppSearch, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                                <TextBlock Text="Search apps…" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="{Binding AppSearch, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                            </Grid>
                            <CheckBox Grid.Column="1" Content="Show protected components" IsChecked="{Binding ShowProtected}" Margin="12,0,0,0" />
                        </Grid>
                        <TextBlock Text="{Binding AppSummary}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" Foreground="{StaticResource CyanBrush}" />
                    </StackPanel>
                </Border>
                <ListBox ItemsSource="{Binding AppsView}" VirtualizingPanel.IsVirtualizingWhenGrouping="True" Margin="0,0,0,10">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" Margin="10,14,0,4" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="280" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Selected}" IsEnabled="{Binding CanRemove}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Value}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Caption}"><Run Text="{Binding Package, Mode=OneWay}" /><Run Text="  v" /><Run Text="{Binding Version, Mode=OneWay}" /></TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Notes}" Style="{StaticResource Body}" FontSize="12" VerticalAlignment="Center" Margin="10,0" />
                                <Border Grid.Column="3" Style="{StaticResource Badge}" Background="{Binding Risk, Converter={StaticResource StatusBrush}, ConverterParameter=soft}">
                                    <TextBlock Text="{Binding Risk}" Style="{StaticResource BadgeText}" Foreground="{Binding Risk, Converter={StaticResource StatusBrush}}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </TabItem>

        <!-- ============================ Scheduled tasks -->
        <TabItem Header="Scheduled tasks">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Optional Windows tasks" Style="{StaticResource H2}" />
                                <Button Content="Refresh" Command="{Binding LoadTasksCommand}" Style="{StaticResource SmallButton}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                            </Grid>
                            <TextBlock Text="Only tasks with a documented, non-essential purpose are listed. Security, update, servicing, TPM, time sync and storage maintenance tasks are protected." Style="{StaticResource Caption}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Tasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource InnerCard}" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Value}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Path}" Style="{StaticResource Mono}" FontSize="11" />
                                                    <TextBlock Text="{Binding Purpose}" Style="{StaticResource Body}" FontSize="12.5" Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding Effect}" Style="{StaticResource Caption}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource Caption}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                    <Button Style="{StaticResource SwitchButton}" Tag="{Binding IsEnabled}" IsEnabled="{Binding Exists}" ToolTip="On = task enabled"
                                                            Command="{Binding DataContext.ToggleTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Third-party tasks that run at logon/boot (hidden startup items)" Style="{StaticResource H2}" />
                            <ItemsControl ItemsSource="{Binding LogonTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding TaskPath}" Style="{StaticResource Value}" />
                                                <TextBlock Style="{StaticResource Caption}"><Run Text="{Binding Author, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Action, Mode=OneWay}" /></TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource SwitchButton}" Tag="{Binding Enabled}"
                                                    Command="{Binding DataContext.DisableLogonTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============================ Optional features -->
        <TabItem Header="Optional features">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Optional Windows features" Style="{StaticResource H2}" />
                        <TextBlock Text="Changes run DISM and usually complete after a restart. Virtualization (Hyper-V, Virtual Machine Platform, WSL), .NET and security features are never disabled by this app." Style="{StaticResource Caption}" Margin="0,0,0,8" />
                        <CheckBox Content="Show all features (read-only information for uncurated ones)" IsChecked="{Binding ShowAllFeatures}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Features}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource InnerCard}" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Value}" FontWeight="SemiBold"><Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding FeatureName, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Normal" /></TextBlock>
                                                <TextBlock Text="{Binding Purpose}" Style="{StaticResource Body}" FontSize="12.5" />
                                                <TextBlock Text="{Binding Recommendation}" Style="{StaticResource Caption}" Foreground="{StaticResource CyanBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StateText}" Style="{StaticResource Caption}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                <Button Style="{StaticResource SwitchButton}" Tag="{Binding IsEnabled}" ToolTip="On = feature enabled"
                                                        Command="{Binding DataContext.ToggleFeatureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </TabItem>

        <!-- ============================ Background processes -->
        <TabItem Header="Background processes">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                    <StackPanel>
                        <WrapPanel>
                            <Button Content="Refresh (1 s sample)" Command="{Binding RefreshProcessesCommand}" />
                            <Button Content="End selected process…" Command="{Binding EndProcessCommand}" CommandParameter="{Binding SelectedProcess}" Style="{StaticResource DangerButton}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Text="CPU is averaged over one second across all cores. I/O includes disk and network transfers. Nothing is ever ended without your confirmation; Windows processes cannot be ended here. To stop an app permanently, disable its startup entry." />
                    </StackPanel>
                </Border>
                <DataGrid ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}" Margin="0,0,0,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="180" />
                        <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="*" />
                        <DataGridTextColumn Header="CPU %" Binding="{Binding CpuPercent, StringFormat={}{0:0.0}}" Width="70" />
                        <DataGridTextColumn Header="Private RAM" Binding="{Binding PrivateBytes, Converter={StaticResource Bytes}}" Width="100" />
                        <DataGridTextColumn Header="I/O" Binding="{Binding DiskBytesPerSec, Converter={StaticResource Bytes}, ConverterParameter=rate}" Width="100" />
                        <DataGridTextColumn Header="Startup entry" Binding="{Binding StartupEntryName}" Width="150" />
                        <DataGridCheckBoxColumn Header="Windows" Binding="{Binding IsSystemProcess}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- ============================ Cleanup -->
        <TabItem Header="Temporary files">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <WrapPanel>
                                <Button Content="Scan" Command="{Binding ScanCleanupCommand}" Style="{StaticResource PrimaryButton}" />
                                <Button Content="Delete selected…" Command="{Binding DeleteCleanupCommand}" Style="{StaticResource DangerButton}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding CleanupSummary}" Style="{StaticResource Caption}" Margin="0,8,0,8" />
                            <ListBox ItemsSource="{Binding Cleanup}" SelectedItem="{Binding SelectedCleanup}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <CheckBox IsChecked="{Binding Selected}">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            </CheckBox>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="26,2,0,0" />
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Caption}" Foreground="{StaticResource CyanBrush}" Margin="26,0,0,0" />
                                            <TextBlock Text="{Binding Warning}" Style="{StaticResource Caption}" Foreground="{StaticResource WarningBrush}" Margin="26,0,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="RECYCLE BIN &amp; WINDOWS TOOLS" Style="{StaticResource H3}" Margin="0,14,0,6" />
                            <TextBlock Text="{Binding RecycleText}" Style="{StaticResource Body}" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Empty Recycle Bin…" Command="{Binding EmptyRecycleCommand}" Style="{StaticResource SmallButton}" />
                                <Button Content="Disk Cleanup (servicing data)" Command="{Binding OpenDiskCleanupCommand}" Style="{StaticResource SmallButton}" />
                                <Button Content="Storage settings" Command="{Binding OpenStorageCommand}" Style="{StaticResource SmallButton}" />
                            </WrapPanel>
                            <TextBlock Text="Windows Update caches and component store data are only cleaned through Windows' own Disk Cleanup / Storage Sense." Style="{StaticResource Caption}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Files in selected category (largest 300)" Style="{StaticResource H2}" />
                        <DataGrid ItemsSource="{Binding PreviewFiles}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" />
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeBytes, Converter={StaticResource Bytes}}" Width="80" />
                                <DataGridTextColumn Header="Modified" Binding="{Binding LastWriteTime, StringFormat={}{0:yyyy-MM-dd}}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
