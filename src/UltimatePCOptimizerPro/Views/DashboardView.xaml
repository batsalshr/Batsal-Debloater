<UserControl x:Class="UltimatePCOptimizerPro.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:UltimatePCOptimizerPro.Controls">
    <UserControl.Resources>
        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,20">
        <StackPanel>
            <!-- Hero -->
            <Border Style="{StaticResource Card}" Background="{StaticResource HeroGradientBrush}" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="PERFORMANCE TIER" Style="{StaticResource H3}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding TierText}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource AccentGradientBrush}" />
                            <TextBlock Text="{Binding TierScore}" Style="{StaticResource Body}" VerticalAlignment="Bottom" Margin="12,0,0,5" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0">
                            <Run Text="Default profile:" /> <Run Text="{Binding ProfileText, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                            <Run Text="  ·  Recommended changes pending:" /> <Run Text="{Binding RecommendedCount, Mode=OneWay}" Foreground="{StaticResource CyanBrush}" FontWeight="SemiBold" />
                        </TextBlock>
                        <WrapPanel Margin="0,14,0,0">
                            <Button Content="Tier analysis" Command="{Binding OpenTierCommand}" Style="{StaticResource SmallButton}" />
                            <Button Content="Rescan hardware" Command="{Binding RescanCommand}" Style="{StaticResource SmallButton}" />
                        </WrapPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource HeroButton}" Command="{Binding SmartOptimizeCommand}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <TextBlock Text="SMART OPTIMIZE PC" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Live metrics -->
            <UniformGrid Columns="5" Margin="0,0,-12,0">
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="CPU" Style="{StaticResource H3}" />
                        <TextBlock Text="{Binding CpuValue}" Style="{StaticResource BigNumber}" />
                        <c:SparklineChart Values="{Binding CpuHistory}" Maximum="100" Height="46" Stroke="{StaticResource AccentBrush}" Margin="0,6" />
                        <TextBlock Text="{Binding CpuDetail}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="GPU" Style="{StaticResource H3}" />
                        <TextBlock Text="{Binding GpuValue}" Style="{StaticResource BigNumber}" />
                        <c:SparklineChart Values="{Binding GpuHistory}" Maximum="100" Height="46" Stroke="{StaticResource PurpleBrush}" Margin="0,6" />
                        <TextBlock Text="{Binding GpuDetail}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="MEMORY" Style="{StaticResource H3}" />
                        <TextBlock Text="{Binding RamValue}" Style="{StaticResource BigNumber}" />
                        <c:SparklineChart Values="{Binding RamHistory}" Maximum="100" Height="46" Stroke="{StaticResource CyanBrush}" Margin="0,6" />
                        <TextBlock Text="{Binding RamDetail}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="DISK ACTIVE" Style="{StaticResource H3}" />
                        <TextBlock Text="{Binding DiskValue}" Style="{StaticResource BigNumber}" />
                        <c:SparklineChart Values="{Binding DiskHistory}" Maximum="100" Height="46" Stroke="{StaticResource WarningBrush}" Margin="0,6" />
                        <TextBlock Text="All physical disks" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="NETWORK" Style="{StaticResource H3}" />
                        <TextBlock Text="{Binding NetValue}" Style="{StaticResource BigNumber}" FontSize="24" />
                        <c:SparklineChart Values="{Binding NetHistory}" Height="46" Stroke="{StaticResource SuccessBrush}" Margin="0,6" />
                        <TextBlock Text="{Binding NetDetail}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="This PC" Style="{StaticResource H2}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Processor" Style="{StaticResource Body}" Margin="0,4" />
                                <TextBlock Grid.Column="1" Text="{Binding CpuName}" Style="{StaticResource Value}" Margin="0,4" />
                                <TextBlock Grid.Row="1" Text="Graphics" Style="{StaticResource Body}" Margin="0,4" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GpuName}" Style="{StaticResource Value}" Margin="0,4" />
                                <TextBlock Grid.Row="2" Text="Memory" Style="{StaticResource Body}" Margin="0,4" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RamText}" Style="{StaticResource Value}" Margin="0,4" />
                                <TextBlock Grid.Row="3" Text="Windows" Style="{StaticResource Body}" Margin="0,4" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WindowsText}" Style="{StaticResource Value}" Margin="0,4" />
                                <TextBlock Grid.Row="4" Text="Displays" Style="{StaticResource Body}" Margin="0,4" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DisplayText}" Style="{StaticResource Value}" Margin="0,4" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Recommended optimizations" Style="{StaticResource H2}" />
                            <ItemsControl ItemsSource="{Binding Recommendations}" ItemTemplate="{StaticResource BulletTemplate}" />
                            <TextBlock Text="Everything recommended for your tier is already applied." Style="{StaticResource Caption}"
                                       Visibility="{Binding Recommendations.Count, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                            <Button Content="Review in Smart Optimize" Command="{Binding SmartOptimizeCommand}" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Restore point status" Style="{StaticResource H2}" />
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="{Binding RestorePointOk, Converter={StaticResource StatusBrush}}" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding RestorePointText}" Style="{StaticResource Value}" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding RestorePointDetail}" Style="{StaticResource Caption}" Margin="18,4,0,0" />
                            <Button Content="Open recovery center" Command="{Binding OpenRecoveryCommand}" Style="{StaticResource SmallButton}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Detected bottlenecks" Style="{StaticResource H2}" />
                            <ItemsControl ItemsSource="{Binding Bottlenecks}" ItemTemplate="{StaticResource BottleneckTemplate}" />
                            <TextBlock Text="No bottlenecks detected in the last scan." Style="{StaticResource Caption}"
                                       Visibility="{Binding Bottlenecks.Count, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Recent operations" Style="{StaticResource H2}" />
                            <ItemsControl ItemsSource="{Binding RecentOperations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Value}" />
                                                <TextBlock Text="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource Badge}" Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=soft}">
                                                <TextBlock Text="{Binding Status}" Style="{StaticResource BadgeText}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No optimizations have been applied yet." Style="{StaticResource Caption}"
                                       Visibility="{Binding RecentOperations.Count, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
