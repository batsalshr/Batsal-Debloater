<UserControl x:Class="UltimatePCOptimizerPro.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:UltimatePCOptimizerPro.Views"
             xmlns:c="clr-namespace:UltimatePCOptimizerPro.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,20">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Active connection" Style="{StaticResource H2}" />
                        <ItemsControl ItemsSource="{Binding Info}" ItemTemplate="{StaticResource InfoRowTemplate}" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Network settings" Command="{Binding OpenNetworkSettingsCommand}" Style="{StaticResource SmallButton}" />
                            <Button Content="Per-process bandwidth (Resource Monitor)" Command="{Binding OpenResourceMonitorCommand}" Style="{StaticResource SmallButton}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Ping, jitter and packet loss" Style="{StaticResource H2}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Target, UpdateSourceTrigger=LostFocus}" ToolTip="Host name or IP address (e.g. your game server)" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}" MinWidth="40" Width="44" Margin="6,0,0,0" ToolTip="Presets" />
                            <Button Grid.Column="2" Margin="8,0,0,0" Command="{Binding ToggleMonitorCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Content" Value="Start monitor" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                                <Setter Property="Content" Value="Stop" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="3" Content="100-ping test" Command="{Binding QuickTestCommand}" Margin="0" />
                        </Grid>
                        <c:SparklineChart Values="{Binding PingHistory}" Height="90" Stroke="{StaticResource SuccessBrush}" ShowGrid="True" Unit=" ms" Margin="0,12,0,6" />
                        <TextBlock Text="{Binding MonitorStats}" Style="{StaticResource Body}" />
                        <TextBlock Text="{Binding TestResult}" Style="{StaticResource Body}" Foreground="{StaticResource CyanBrush}" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Label next result as" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox SelectedValue="{Binding ResultLabel}" SelectedValuePath="Content" MinWidth="110">
                                <ComboBoxItem Content="Before" />
                                <ComboBoxItem Content="After" />
                                <ComboBoxItem Content="Ethernet" />
                                <ComboBoxItem Content="Wi-Fi" />
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Before / after comparison" Style="{StaticResource H2}" />
                        <Button Content="Clear history" Command="{Binding ClearSavedCommand}" Style="{StaticResource SmallButton}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                    </Grid>
                    <TextBlock Text="{Binding Comparison}" Style="{StaticResource Body}" Foreground="{StaticResource CyanBrush}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Saved}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" Style="{StaticResource Mono}" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Bufferbloat test" Style="{StaticResource H2}" />
                            <Button Content="Run test" Command="{Binding BufferbloatCommand}" Style="{StaticResource SmallButton}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        </Grid>
                        <TextBlock Text="Measures how much latency rises while the connection is saturated (download only)." Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding BloatGrade}" FontSize="40" FontWeight="Bold" Foreground="{StaticResource AccentGradientBrush}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding BloatResult}" Style="{StaticResource Body}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="DNS resolver benchmark" Style="{StaticResource H2}" />
                            <Button Content="Run benchmark" Command="{Binding BenchmarkDnsCommand}" Style="{StaticResource SmallButton}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        </Grid>
                        <DataGrid ItemsSource="{Binding DnsResults}" MaxHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Resolver" Binding="{Binding Label}" Width="*" />
                                <DataGridTextColumn Header="Server" Binding="{Binding Server}" Width="120" />
                                <DataGridTextColumn Header="Avg ms" Binding="{Binding AverageMs, StringFormat={}{0:0.0}}" Width="70" />
                                <DataGridTextColumn Header="Min" Binding="{Binding MinMs, StringFormat={}{0:0.0}}" Width="60" />
                                <DataGridTextColumn Header="Max" Binding="{Binding MaxMs, StringFormat={}{0:0.0}}" Width="60" />
                                <DataGridTextColumn Header="Failed" Binding="{Binding Failures}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding DnsStatus}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Route to game server (traceroute)" Style="{StaticResource H2}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding TraceTarget}" />
                            <Button Grid.Column="1" Content="Trace" Command="{Binding TraceCommand}" Margin="8,0,0,0" />
                        </Grid>
                        <DataGrid ItemsSource="{Binding Hops}" MaxHeight="320" Margin="0,10,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Hop" Binding="{Binding Hop}" Width="50" />
                                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="*" />
                                <DataGridTextColumn Header="ms" Binding="{Binding RoundTripMs, StringFormat={}{0:0}}" Width="60" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Router, QoS/SQM and connection advice" Style="{StaticResource H2}" />
                        <ItemsControl ItemsSource="{Binding RouterTips}" ItemTemplate="{StaticResource BulletTemplate}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Network settings" Style="{StaticResource H2}" />
                    <v:TweakListView DataContext="{Binding Tweaks}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
