<UserControl x:Class="UltimatePCOptimizerPro.Views.BenchmarksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:UltimatePCOptimizerPro.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,20">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Frame-time capture (PresentMon)" Style="{StaticResource H2}" />
                        <TextBlock Text="{Binding PresentMonInfo}" Style="{StaticResource Caption}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding PresentMonPath}" IsReadOnly="True" />
                            <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowsePresentMonCommand}" Margin="8,0,0,0" />
                            <Button Grid.Column="2" Content="Download page" Command="{Binding OpenPresentMonPageCommand}" Style="{StaticResource GhostButton}" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Game process" Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <Grid Grid.Column="1" Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}" ToolTip="e.g. cs2.exe" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding RunningProcesses}" SelectedItem="{Binding ProcessName}" Width="44" MinWidth="40" Margin="6,0,0,0" ToolTip="Running windowed processes" />
                                <Button Grid.Column="2" Content="&#xE72C;" FontFamily="{StaticResource IconFont}" Command="{Binding RefreshProcessesCommand}" Margin="6,0,0,0" />
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Duration" Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Durations}" SelectedItem="{Binding Duration}" ItemStringFormat="{}{0} s" HorizontalAlignment="Left" Margin="0,3" />
                            <TextBlock Grid.Row="2" Text="Run name" Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RunName}" Margin="0,3" />
                            <TextBlock Grid.Row="3" Text="Tag" Style="{StaticResource Body}" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Tags}" SelectedItem="{Binding Tag}" HorizontalAlignment="Left" Margin="0,3" />
                            <CheckBox Grid.Row="4" Grid.Column="1" Content="Also record ping/jitter to the Network page target" IsChecked="{Binding RecordPing}" Margin="0,6" />
                        </Grid>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Start capture" Command="{Binding CaptureCommand}" Style="{StaticResource PrimaryButton}" />
                            <Button Content="Telemetry only (no FPS)" Command="{Binding RecordTelemetryCommand}" />
                            <Button Content="Stop" Command="{Binding StopCommand}" Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Import CSV…" Command="{Binding ImportCommand}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Body}" Foreground="{StaticResource CyanBrush}" Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="For valid comparisons: same scene/route, same in-game settings, same duration, game warmed up (shaders compiled), and at least two runs each." />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <TextBlock Text="Benchmark history" Style="{StaticResource H2}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button Content="Export report" Command="{Binding ExportReportCommand}" Style="{StaticResource SmallButton}" />
                                <Button Content="Delete" Command="{Binding DeleteRunCommand}" Style="{StaticResource SmallButton}" Margin="0" />
                            </StackPanel>
                        </Grid>
                        <DataGrid ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" MaxHeight="360">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="70" />
                                <DataGridTextColumn Header="Date" Binding="{Binding Timestamp, StringFormat={}{0:MM-dd HH:mm}}" Width="85" />
                                <DataGridTextColumn Header="Avg FPS" Binding="{Binding Frames.AverageFps, StringFormat={}{0:0.0}}" Width="70" />
                                <DataGridTextColumn Header="1% low" Binding="{Binding Frames.OnePercentLowFps, StringFormat={}{0:0.0}}" Width="65" />
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="95" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Visibility="{Binding SelectedRun, Converter={StaticResource NullToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}"><Run Text="Run details: " /><Run Text="{Binding SelectedRun.Name, Mode=OneWay}" /></TextBlock>
                    <TextBlock Text="{Binding RunDetails}" Style="{StaticResource Mono}" Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="FRAME TIME (ms) — spikes are stutters" Style="{StaticResource H3}" Margin="0,14,0,4" />
                    <c:SparklineChart Values="{Binding FrameTimes}" Height="140" Stroke="{StaticResource CyanBrush}" ShowGrid="True" Unit=" ms" />
                    <UniformGrid Columns="4" Margin="0,12,0,0">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="CPU %" Style="{StaticResource H3}" />
                            <c:SparklineChart Values="{Binding CpuSeries}" Maximum="100" Height="60" Stroke="{StaticResource AccentBrush}" ShowGrid="True" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="GPU %" Style="{StaticResource H3}" />
                            <c:SparklineChart Values="{Binding GpuSeries}" Maximum="100" Height="60" Stroke="{StaticResource PurpleBrush}" ShowGrid="True" />
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="RAM %" Style="{StaticResource H3}" />
                            <c:SparklineChart Values="{Binding RamSeries}" Maximum="100" Height="60" Stroke="{StaticResource CyanBrush}" ShowGrid="True" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="PING (ms)" Style="{StaticResource H3}" />
                            <c:SparklineChart Values="{Binding PingSeries}" Height="60" Stroke="{StaticResource SuccessBrush}" ShowGrid="True" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Before / after comparison" Style="{StaticResource H2}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Before" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding Runs}" SelectedItem="{Binding CompareBefore}" DisplayMemberPath="Name" MinWidth="240" />
                        <TextBlock Text="After" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="16,0,8,0" />
                        <ComboBox ItemsSource="{Binding Runs}" SelectedItem="{Binding CompareAfter}" DisplayMemberPath="Name" MinWidth="240" />
                        <Button Content="Compare" Command="{Binding CompareCommand}" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding ComparisonRows}" Margin="0,12,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="*" />
                            <DataGridTextColumn Header="Before" Binding="{Binding Before}" Width="120" />
                            <DataGridTextColumn Header="After" Binding="{Binding After}" Width="120" />
                            <DataGridTemplateColumn Header="Change" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Delta}" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Improved}" Value="True"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Improved}" Value="False"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Differences within about ±3% are usually run-to-run variance. 1% / 0.1% lows use the percentile method (1000 ÷ 99th / 99.9th percentile frame time)." Style="{StaticResource Caption}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
