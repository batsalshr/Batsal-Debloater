<UserControl x:Class="UltimatePCOptimizerPro.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,0,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,10">
            <Button Content="Refresh" Command="{Binding ReloadCommand}" />
            <Button Content="Export to CSV" Command="{Binding ExportCsvCommand}" />
            <Button Content="Open log folder" Command="{Binding OpenLogsCommand}" />
        </WrapPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Operations audit trail" Style="{StaticResource H2}" />
                <DataGrid ItemsSource="{Binding Entries}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss zzz}}" Width="190" />
                        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="80" />
                        <DataGridTextColumn Header="Operation" Binding="{Binding Label}" Width="180" />
                        <DataGridTemplateColumn Header="Status" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Badge}" Background="{Binding Status, Converter={StaticResource StatusBrush}, ConverterParameter=soft}">
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource BadgeText}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Applied" Binding="{Binding Applied}" Width="65" />
                        <DataGridTextColumn Header="Failed" Binding="{Binding Failed}" Width="60" />
                        <DataGridTextColumn Header="Restore point" Binding="{Binding RestorePointStatus}" Width="110" />
                        <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Recent application log (this session)" Style="{StaticResource H2}" />
                <DataGrid ItemsSource="{Binding LogEntries}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat={}{0:HH:mm:ss.fff}}" Width="95" />
                        <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="75" />
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="110" />
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
